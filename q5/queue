//Write a program to perform enque and deque in a queue
//i used arrays 

#include <iostream>
using namespace std;

#define SIZE 5

int queue[SIZE];
int front = -1, rear = -1;

void enqueue(int item) {
    if (rear == SIZE - 1) {
        cout << "Queue Overflow! Cannot insert " << item << endl;
        return;
    }
    if (front == -1)        // first element
        front = 0;
    rear++;
    queue[rear] = item;
    cout << item << " enqueued" << endl;
}
void dequeue() {
    if (front == -1 || front > rear) {
        cout << "Queue Underflow! Queue is empty" << endl;
        return;
    }
    cout << queue[front] << " dequeued" << endl;
    front++;
    if (front > rear)       // queue became empty, reset
        front = rear = -1;
}
void display() {
    if (front == -1) {
        cout << "Queue is empty" << endl;
        return;
    }
    cout << "Queue elements: ";
    for (int i = front; i <= rear; i++)
        cout << queue[i] << " ";
    cout << endl;
}
int main() {
    int choice, item;
    while (true) {
        cout << "\n1. Enqueue\n2. Dequeue\n3. Display\n4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;
        switch (choice) {
            case 1:
                cout << "Enter the value: ";
                cin >> item;
                enqueue(item);
                break;
            case 2:
                dequeue();
                break;
            case 3:
                display();
                break;
            case 4:
                return 0;
            default:
                cout << "Invalid choice" << endl;
        }
    }
}